{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"palette": [
				{
					"name": "Principal",
					"slug": "primary",
					"color": "#0F172A"
				},
				{
					"name": "Acento",
					"slug": "accent",
					"color": "#10B981"
				},
				{
					"name": "Acento intenso",
					"slug": "accent-strong",
					"color": "#059669"
				},
				{
					"name": "Texto",
					"slug": "lumen-text",
					"color": "#111827"
				},
				{
					"name": "Texto atenuado",
					"slug": "text-muted",
					"color": "#64748B"
				},
				{
					"name": "Superficie",
					"slug": "surface",
					"color": "#FFFFFF"
				},
				{
					"name": "Fondo",
					"slug": "background",
					"color": "#F8FAFC"
				},
				{
					"name": "Borde",
					"slug": "lumen-border",
					"color": "#CBD5E1"
				},
				{
					"name": "Éxito",
					"slug": "success",
					"color": "#15803D"
				},
				{
					"name": "Advertencia",
					"slug": "warning",
					"color": "#D97706"
				},
				{
					"name": "Error",
					"slug": "error",
					"color": "#DC2626"
				},
				{
					"name": "Información",
					"slug": "info",
					"color": "#2563EB"
				},
				{
					"name": "Inverso",
					"slug": "inverse",
					"color": "#FFFFFF"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Suave",
					"slug": "sm",
					"shadow": "0 1px 2px rgba(15, 23, 42, 0.08)"
				},
				{
					"name": "Medio",
					"slug": "md",
					"shadow": "0 10px 30px rgba(15, 23, 42, 0.10)"
				},
				{
					"name": "Grande",
					"slug": "lg",
					"shadow": "0 20px 50px rgba(15, 23, 42, 0.16)"
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"name": "4 px",
					"slug": "1",
					"size": "0.25rem"
				},
				{
					"name": "8 px",
					"slug": "2",
					"size": "0.5rem"
				},
				{
					"name": "12 px",
					"slug": "3",
					"size": "0.75rem"
				},
				{
					"name": "16 px",
					"slug": "4",
					"size": "1rem"
				},
				{
					"name": "24 px",
					"slug": "5",
					"size": "1.5rem"
				},
				{
					"name": "32 px",
					"slug": "6",
					"size": "2rem"
				},
				{
					"name": "48 px",
					"slug": "7",
					"size": "3rem"
				},
				{
					"name": "64 px",
					"slug": "8",
					"size": "4rem"
				},
				{
					"name": "80 px",
					"slug": "9",
					"size": "5rem"
				},
				{
					"name": "96 px",
					"slug": "10",
					"size": "6rem"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"name": "Sans del sistema",
					"slug": "sans"
				},
				{
					"fontFamily": "ui-serif, Georgia, Cambria, 'Times New Roman', serif",
					"name": "Serif del sistema",
					"slug": "serif"
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"name": "Monoespaciada del sistema",
					"slug": "mono"
				}
			],
			"fontSizes": [
				{
					"name": "Destacado",
					"slug": "display",
					"size": "clamp(2.5rem, 5vw, 4.5rem)"
				},
				{
					"name": "H1",
					"slug": "h1",
					"size": "clamp(2.1rem, 4vw, 3.5rem)"
				},
				{
					"name": "H2",
					"slug": "h2",
					"size": "clamp(1.7rem, 3vw, 2.5rem)"
				},
				{
					"name": "H3",
					"slug": "h3",
					"size": "clamp(1.35rem, 2vw, 1.75rem)"
				},
				{
					"name": "Cuerpo",
					"slug": "body",
					"size": "1rem"
				},
				{
					"name": "Pequeño",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "Leyenda",
					"slug": "caption",
					"size": "0.75rem"
				}
			],
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				},
				"spacing": {
					"padding": true
				},
				"typography": {
					"fontSize": true
				}
			},
			"core/navigation": {
				"color": {
					"text": true
				},
				"spacing": {
					"blockGap": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|lumen-text"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|5",
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|4",
				"bottom": "0",
				"left": "var:preset|spacing|4"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|body",
			"lineHeight": "1.6"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "8px"
				},
				"color": {
					"background": "var:preset|color|accent",
					"text": "#FFFFFF"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"right": "1.25rem",
						"bottom": "0.8rem",
						"left": "1.25rem"
					}
				},
				"typography": {
					"fontWeight": "600"
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.18"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent-strong"
				},
				"typography": {
					"textDecoration": "underline"
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "8px"
				}
			},
			"core/quote": {
				"border": {
					"color": "var:preset|color|accent",
					"width": "3px"
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var:preset|color|lumen-border",
					"width": "1px"
				}
			}
		}
	}
}
